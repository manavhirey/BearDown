#!/usr/bin/env python3
"""HTTP access to the CoachBear dashboard API for the coach-bear agent.

Usage:  ./dashboard/api GET /api/plans
        ./dashboard/api POST /api/plans/2026-W29/done '{"day": "Monday", "done": true}'
        ./dashboard/api DELETE /api/workouts/cardio/12

Base URL comes from COACH_API_URL (default http://127.0.0.1:8737). When the
dashboard is reached through the basicauth proxy (bear.kunigami.cloud), set
COACH_API_AUTH="user:password" and the wrapper sends the Authorization header.
Like dbquery, one spaceless Bash permission rule covers every call:
Bash(./dashboard/api:*).
"""
import base64
import os
import sys
import urllib.error
import urllib.request


def main(argv):
    if len(argv) < 2 or argv[0].upper() not in {"GET", "POST", "DELETE"}:
        print(__doc__, file=sys.stderr)
        return 2
    method, path = argv[0].upper(), argv[1]
    if not path.startswith("/"):
        print("path must start with '/'", file=sys.stderr)
        return 2
    body = " ".join(argv[2:]).encode() if len(argv) > 2 else None
    base = os.environ.get("COACH_API_URL", "http://127.0.0.1:8737")
    headers = {"Content-Type": "application/json"}
    auth = os.environ.get("COACH_API_AUTH")
    if auth:
        headers["Authorization"] = "Basic " + base64.b64encode(auth.encode()).decode()
    req = urllib.request.Request(base + path, data=body, method=method, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=60) as resp:
            print(resp.read().decode())
    except urllib.error.HTTPError as exc:
        print(exc.read().decode())
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
